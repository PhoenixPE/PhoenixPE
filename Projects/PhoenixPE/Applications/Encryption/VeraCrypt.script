[Main]
Title=VeraCrypt
Description=(v1.26.29 x64) VeraCrypt is a free open source disk encryption software based on TrueCrypt 7.1a.
Author=Homes32
Level=5
Selected=False
Mandatory=False
Version=1.2.1.0
Date=2026-10-23

[Variables]
%ProgramFolder%="VeraCrypt"
%ProgramExe%="VeraCrypt.exe"
%ProgramVersion%="1.26.29
%SetupFile%="VeraCrypt-%ProgramVersion%.msi"
%DownloadURL%=https://sourceforge.net/projects/veracrypt/files/VeraCrypt#$p20%ProgramVersion%/Windows/VeraCrypt_Setup_x64_%ProgramVersion%.msi/download
%ConfigFile%="%TargetDir%\Users\Default\AppData\Roaming\VeraCrypt\Configuration.xml"

[Process]
Echo,"Processing %ScriptTitle%..."

If,Not,%SourceArch%,Equal,x64,Exit,"Error: Veracrypt can only be used with a x64 source."

If,%cb_RunFromRam%,Equal,True,RunFromRam

///////////////////////////////////////////////////////////////////////////////////
// Extract
If,Not,ExistFile,"%ProgramsCache%\%ProgramFolder%\%SetupFile%",Run,%ScriptFile%,DownloadProgram
Run,%ScriptFile%,ExtractProgram,"%ProjectTemp%\%ProgramFolder%"

///////////////////////////////////////////////////////////////////////////////////
// Register Veracrypt 

Run,%ScriptFile%,RegisterVeraCrypt

///////////////////////////////////////////////////////////////////////////////////
// Settings

Echo,"Configuring %ScriptTitle%..."

StrFormat,SPLIT,%cmb_Language%,"[",2,%Lang%
StrFormat,RTRIM,%Lang%,1,%Lang%

// Build the XML Config File
FileCreateBlank,%ConfigFile%
TXTAddLine,%ConfigFile%,"<VeraCrypt></VeraCrypt>",Append
XMLAdd,SubNode,%ConfigFile%,"VeraCrypt","Element","configuration",""

// Language
XMLAdd,Append,%ConfigFile%,"VeraCrypt/configuration","Element","config","en"
XMLAdd,Append,%ConfigFile%,"VeraCrypt/configuration/config[last()]","Attribute","key","Language"

// Start on Logon
XMLAdd,Append,%ConfigFile%,"VeraCrypt/configuration","Element","config","0"
XMLAdd,Append,%ConfigFile%,"VeraCrypt/configuration/config[last()]","Attribute","key","StartOnLogon"

// Keep running in SysTray
XMLAdd,Append,%ConfigFile%,"VeraCrypt/configuration","Element","config","0"
XMLAdd,Append,%ConfigFile%,"VeraCrypt/configuration/config[last()]","Attribute","key","EnableBackgroundTask"

XMLFormat,%ConfigFile%,Pretty

///////////////////////////////////////////////////////////////////////////////////
// Shortcuts

If,%cb_DesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%","","%PEPrograms%\%ProgramFolder%"
If,%cb_StartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\%ProgramExe%","","%PEPrograms%\%ProgramFolder%"
If,%cb_PinToTaskbar%,Equal,True,PinShortcut,Taskbar,Auto,"%PEPrograms%\%ProgramFolder%\%ProgramExe%"
If,%cb_PinToStartMenu%,Equal,True,PinShortcut,StartMenu,Auto,"%PEPrograms%\%ProgramFolder%\%ProgramExe%"

[#RegisterVeracrypt#]
// ===============================================================================================================================
// Name...........: RegisterVeraCrypt
// Description....: Register the VeraCrypt driver and COM interfaces.
// Syntax.........: Run,%ScriptFile%,RegisterVeraCrypt
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: 
// Related........: 
// ===============================================================================================================================
[RegisterVeracrypt]
Echo,"Registering VeraCrypt..."

RegHiveLoad,Tmp_Software,%RegSoftware%
RegHiveLoad,Tmp_System,%RegSystem%

// Register .hc File Ext.
If,%cb_AssocFileExt%,Equal,True,Begin
  RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\.hc","","VeraCryptVolume"

  RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptVolume","","VeraCrypt Volume"
  RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptVolume","AppUserModelID","IDRIX.VeraCrypt"
  RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptVolume\DefaultIcon","","%PEPrograms%\%ProgramFolder%\VeraCrypt.exe,1"
  RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptVolume\Shell\open\command","","#$q%PEPrograms%\%ProgramFolder%\VeraCrypt.exe#$q /v #$q%1#$q"
End

// VeraCrypt AppId
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\AppID\VeraCrypt.exe","AppId","{FE8B3B95-C80C-41f7-830F-FBA271C26F7E}"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\AppID\{FE8B3B95-C80C-41f7-830F-FBA271C26F7E}","","VeraCrypt class"
RegWrite,HKLM,REG_BINARY,"Tmp_Software\Classes\AppID\{FE8B3B95-C80C-41f7-830F-FBA271C26F7E}","AccessPermission",01,00,04,80,30,00,00,00,40,00,00,00,00,00,00,00,14,00,00,00,02,00,1c,00,01,00,00,00,00,00,14,00,07,00,00,00,01,01,00,00,00,00,00,05,04,00,00,00,01,02,00,00,00,00,00,05,20,00,00,00,20,02,00,00,01,02,00,00,00,00,00,05,20,00,00,00,20,02,00,00

// VeraCrypt Class
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCrypt","","VeraCrypt class"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCrypt\CLSID","","{FE8B3B95-C80C-41f7-830F-FBA271C26F7E}"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCrypt\CurVer","","VeraCrypt.1"

RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCrypt.1","","VeraCrypt class"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCrypt.1\CLSID","","{FE8B3B95-C80C-41f7-830F-FBA271C26F7E}"

// VeraCrypt COM Interface
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\Interface\{C786E27C-2801-482C-B45D-D4357B270A29}","","ITrueCryptMainCom"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\Interface\{C786E27C-2801-482C-B45D-D4357B270A29}\ProxyStubClsid32","","{00020424-0000-0000-C000-000000000046}"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\Interface\{C786E27C-2801-482C-B45D-D4357B270A29}\TypeLib","","{9ACF6176-5FC4-4690-A025-B3306A50EB6A}"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\Interface\{C786E27C-2801-482C-B45D-D4357B270A29}\TypeLib","Version","2.a"

// VeraCrypt Main UAC Support Library
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{9ACF6176-5FC4-4690-A025-B3306A50EB6A}\2.a","","VeraCrypt Main UAC Support Library"
If,%SourceArch%,Equal,x64,RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{9ACF6176-5FC4-4690-A025-B3306A50EB6A}\2.a\0\win64","","%PEPrograms%\%ProgramFolder%\VeraCrypt.exe"
Else,If,%SourceArch%,Equal,arm64,RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{9ACF6176-5FC4-4690-A025-B3306A50EB6A}\2.a\0\arm64","","%PEPrograms%\%ProgramFolder%\VeraCrypt.exe"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{9ACF6176-5FC4-4690-A025-B3306A50EB6A}\2.a\FLAGS","","0"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{9ACF6176-5FC4-4690-A025-B3306A50EB6A}\2.a\HELPDIR","%PEPrograms%\%ProgramFolder%"

// VeraCrypt Format AppId
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\AppID\VeraCrypt Format.exe","AppId","{A96D3797-9F31-49f4-A0CE-9657392CF789}"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\AppID\{A96D3797-9F31-49f4-A0CE-9657392CF789}","","VeraCryptFormat class"
RegWrite,HKLM,REG_BINARY,"Tmp_Software\Classes\AppID\{A96D3797-9F31-49f4-A0CE-9657392CF789}","AccessPermission",01,00,04,80,30,00,00,00,40,00,00,00,00,00,00,00,14,00,00,00,02,00,1c,00,01,00,00,00,00,00,14,00,07,00,00,00,01,01,00,00,00,00,00,05,04,00,00,00,01,02,00,00,00,00,00,05,20,00,00,00,20,02,00,00,01,02,00,00,00,00,00,05,20,00,00,00,20,02,00,00

// VeraCrypt Format Class
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptFormat","","VeraCryptFormat class"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptFormat\CLSID","","{A96D3797-9F31-49f4-A0CE-9657392CF789}"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptFormat\CurVer","","VeraCryptFormat.1"

RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptFormat.1","","VeraCryptFormat class"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\VeraCryptFormat.1\CLSID","","{A96D3797-9F31-49f4-A0CE-9657392CF789}"

// VeraCrypt Format COM Interface
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\Interface\{7AB357D9-A17F-466E-BCD6-F49E97C218D8}","","ITrueCryptFormatCom"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\Interface\{7AB357D9-A17F-466E-BCD6-F49E97C218D8}\ProxyStubClsid32","","{00020424-0000-0000-C000-000000000046}"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\Interface\{7AB357D9-A17F-466E-BCD6-F49E97C218D8}\TypeLib","","{56327DDA-F1A7-4E13-B128-520D129BDEF6}"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\Interface\{7AB357D9-A17F-466E-BCD6-F49E97C218D8}\TypeLib","Version","2.8"

// VeraCrypt Format UAC Support Library
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{56327DDA-F1A7-4E13-B128-520D129BDEF6}\2.8","","VeraCrypt Format UAC Support Library"
If,%SourceArch%,Equal,x64,RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{56327DDA-F1A7-4E13-B128-520D129BDEF6}\2.8\0\win64","","%PEPrograms%\%ProgramFolder%\VeraCryptFormat.exe"
Else,If,%SourceArch%,Equal,arm64,RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{56327DDA-F1A7-4E13-B128-520D129BDEF6}\2.8\0\arm64","","%PEPrograms%\%ProgramFolder%\VeraCryptFormat.exe"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{56327DDA-F1A7-4E13-B128-520D129BDEF6}\2.8\FLAGS","","0"
RegWrite,HKLM,REG_SZ,"Tmp_Software\Classes\TypeLib\{56327DDA-F1A7-4E13-B128-520D129BDEF6}\2.8\HELPDIR","%PEPrograms%\%ProgramFolder%"

// Veracrypt Filter Driver
RegWrite,HKLM,REG_SZ,"Tmp_System\ControlSet001\Services\veracrypt","DisplayName","veracrypt"
RegWrite,HKLM,REG_DWORD,"Tmp_System\ControlSet001\Services\veracrypt","ErrorControl",1
RegWrite,HKLM,REG_EXPAND_SZ,"Tmp_System\ControlSet001\Services\veracrypt","ImagePath","system32\drivers\veracrypt.sys"
RegWrite,HKLM,REG_DWORD,"Tmp_System\ControlSet001\Services\veracrypt","Start",1
RegWrite,HKLM,REG_DWORD,"Tmp_System\ControlSet001\Services\veracrypt","Type",1

RegHiveUnLoad,Tmp_Software
RegHiveUnLoad,Tmp_System

[#ExtractProgram#]
// ===============================================================================================================================
// Name...........: ExtractProgram
// Description....: Extract program files from script/setup files.
// Syntax.........: Run,%ScriptFile%,ExtractProgram,<DestDir>
// Parameters.....: DestDir - The directory where the files will be extracted.
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: 
// ===============================================================================================================================
[ExtractProgram]
Echo,"Extracting Program Files..."
// Make sure we have a clean extract folder
DirDeleteEx,"%ProjectTemp%\%ProgramFolder%"
MsiExtract,"%ProgramsCache%\%ProgramFolder%\%SetupFile%",%^SIPARAM_1%

FileCopy,"%ProjectTemp%\%ProgramFolder%\SourceDir\Drivers\veracrypt.sys","%TargetSystem32%\drivers\veracrypt.sys"
FileCopy,"%ProjectTemp%\%ProgramFolder%\SourceDir\VeraCrypt\*.*","%TargetPrograms%\%ProgramFolder%"

[#DownloadProgram#]
// ===============================================================================================================================
// Name...........: DownloadProgram
// Description....: Download the program files from the author's website.
// Syntax.........: Run,%ScriptFile%,DownloadProgram
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: 
// Related........: 
// ===============================================================================================================================
[DownloadProgram]
Echo,"Downloading %ScriptTitle%..."
WebGet,"%DownloadURL%","%ProgramsCache%\%ProgramFolder%\%SetupFile%",NOERR
If,Not,%^RET%,Equal,200,Halt,"Failed to download [%SetupFile%]: The code returned was [%^RET%]."

[#ClearDownloadCache#]
// ===============================================================================================================================
// Name...........: ClearDownloadCache
// Description....: Remove all downloaded setup and program files.
// Syntax.........: Run,%ScriptFile%,ClearDownloadCache
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: btn_PurgeCache
// ===============================================================================================================================
[ClearDownloadCache]
DirDeleteEx,"%ProgramsCache%\%ProgramFolder%"

[#SetDefaultOptions#]
// ===============================================================================================================================
// Name...........: SetDefaultOptions
// Description....: Sets script options to default values.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: 
// Related........: btn_SetDefaultOptions
// ===============================================================================================================================
[SetDefaultOptions]
System,Cursor,Wait
WriteInterface,Value,%ScriptFile%,Interface,cb_RunFromRam,True
WriteInterface,Value,%ScriptFile%,Interface,cb_DesktopShc,False
WriteInterface,Value,%ScriptFile%,Interface,cb_StartMenuShc,True
WriteInterface,Value,%ScriptFile%,Interface,cb_PinToTaskbar,False
WriteInterface,Value,%ScriptFile%,Interface,cb_PinToStartMenu,False
WriteInterface,Value,%ScriptFile%,Interface,txt_StartMenuFolder,"Encryption"
WriteInterface,Value,%ScriptFile%,Interface,txt_ShortcutName,"VeraCrypt"
WriteInterface,Value,%ScriptFile%,Interface,cmb_Language,"English [en]"
WriteInterface,Value,%ScriptFile%,Interface,cb_AssocFileExt,True
WriteInterface,Value,%ScriptFile%,Interface,cb_StartOnLogon,False
WriteInterface,Value,%ScriptFile%,Interface,cb_EnableBackgroundTask,True
System,Cursor,Normal

[#ToggleAdvancedOptions#]
// ===============================================================================================================================
// Name...........: ToggleAdvancedOptions
// Description....: Show/Hide advanced options.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: btn_AdvancedOptions
// ===============================================================================================================================
[ToggleAdvancedOptions]
Message,"There are no advanced options available for this script."

[#ShowScriptInfo#]
// ===============================================================================================================================
// Name...........: ShowScriptInfo
// Description....: 
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: btn_ScriptInfo
// ===============================================================================================================================
[ShowScriptInfo]
Message,"VeraCrypt is a free open source disk encryption software based on TrueCrypt 7.1a."

