// Note: When updating the AIM-Driver it is important to make sure that the [DeviceInstall32] and [PhDskMnt_RootEnumInstall] sections are
//       not commented out in phdskmnt.ini or the virtual SCSI adapter will not be installed correctly.
//       See https://github.com/ArsenalRecon/Arsenal-Image-Mounter/issues/28

[Main]
Title=Arsenal Image Mounter
Description=(Driver v1.2.29.95 / GUI v3.13.368.0)#$xCreate a Ramdisk that can be used for temp files, programs, etc.
Author=Homes32
Level=4
Selected=True
Mandatory=False
Version=1.1.6.0
Date=2026-06-07

[Variables]
%ProgramFolder%="Arsenal Image Mounter"
%DismLog%="%TargetWindows%\Logs\DISM\dism.log"

[Process]
Echo,"Configuring Arsenal Image Mounter..."

RunFromRam

// Low-Level tools
ExtractFile,%ScriptFile%,Arsenal,AIM_ll-%SourceArch%.7z,%ProjectTemp%
Decompress,"%ProjectTemp%\AIM_ll-%SourceArch%.7z",%TargetSystem32%

// GUI Tools
If,%cb_IncludeAimGUI%,Equal,True,Begin
  Echo,"Extracting GUI Tools..."
  ExtractFile,%ScriptFile%,Arsenal,AIM-GUI.7z,%ProjectTemp%
  Decompress,"%ProjectTemp%\AIM-GUI.7z","%TargetPrograms%\%ProgramFolder%"

  // Shortcuts
  If,%cb_DesktopShc%,Equal,True,AddShortcut,Desktop,"",%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\ArsenalImageMounter.exe","","%PEPrograms%\%ProgramFolder%"
  If,%cb_StartMenuShc%,Equal,True,AddShortcut,StartMenu,%txt_StartMenuFolder%,%txt_ShortcutName%,"%PEPrograms%\%ProgramFolder%\ArsenalImageMounter.exe","","%PEPrograms%\%ProgramFolder%"
  If,%cb_PinToTaskbar%,Equal,True,PinShortcut,Taskbar,Auto,"%ProgramFolder%\ArsenalImageMounter.exe"
  If,%cb_PinToStartMenu%,Equal,True,PinShortcut,StartMenu,Auto,"%ProgramFolder%\ArsenalImageMounter.exe"
End

// Don't load any registry hives before driver integration!
Run,%ScriptFile%,IntegrateDrivers

// Create Ramdisk on boot
If,%cb_CreateRamdisk%,Equal,True,Begin
  Echo,"Configuring Ramdisk..."

  // Config RamDisk Size
  If,%cmb_RamdiskAlloc%,Equal,"Fixed Size",Begin
    // Fixed Size
    If,%cmb_RamdiskSizeMode%,Equal,#$p,Set,%RamDiskSize%,"%num_RamDiskSize%#$p"
    Else,Set,%RamDiskSize%,%num_RamDiskSize%
  End
  Else,If,%cmb_RamdiskAlloc%,Equal,"1GB Dynamic",Begin
    ExtractFile,%ScriptFile%,VHD,Ramdisk-1GB.vhd,%TargetDir%
	Set,%RamDiskSize%,"X:\Ramdisk-1GB.vhd"
  End
  Else,If,%cmb_RamdiskAlloc%,Equal,"2GB Dynamic",Begin
    ExtractFile,%ScriptFile%,VHD,Ramdisk-2GB.vhd,%TargetDir%
	Set,%RamDiskSize%,"X:\Ramdisk-2GB.vhd"
  End
  Else,If,%cmb_RamdiskAlloc%,Equal,"4GB Dynamic",Begin
    ExtractFile,%ScriptFile%,VHD,Ramdisk-4GB.vhd,%TargetDir%
	Set,%RamDiskSize%,"X:\Ramdisk-4GB.vhd"
  End
  Else,If,%cmb_RamdiskAlloc%,Equal,"8GB Dynamic",Begin
    ExtractFile,%ScriptFile%,VHD,Ramdisk-8GB.vhd,%TargetDir%
	Set,%RamDiskSize%,"X:\Ramdisk-8GB.vhd"
  End
  Else,If,%cmb_RamdiskAlloc%,Equal,"16GB Dynamic",Begin
    ExtractFile,%ScriptFile%,VHD,Ramdisk-16GB.vhd,%TargetDir%
	Set,%RamDiskSize%,"X:\Ramdisk-16GB.vhd"
  End
  Else,If,%cmb_RamdiskAlloc%,Equal,"32GB Dynamic",Begin
    ExtractFile,%ScriptFile%,VHD,Ramdisk-32GB.vhd,%TargetDir%
	Set,%RamDiskSize%,"X:\Ramdisk-32GB.vhd"
  End
  Else,Halt,"INTERNAL LOGIC ERROR: Invalid Ramdisk size [%cmb_RamdiskAlloc%]."   
  
  // Add the RamDrive to ENV so our shell loader knows where to create a symlink for pinning from removable media
  RegHiveLoad,Tmp_System,%RegSystem%
  RegWrite,HKLM,REG_SZ,"Tmp_System\ControlSet001\Control\Session Manager\Environment","RamDrive",%cmb_DriveLetter%
  RegHiveUnLoad,Tmp_System

  // Redirect %Temp%
  If,%cb_ChgTemp%,Equal,True,Set,%TmpDirPath%," %cmb_DriveLetter%\Temp"
  Else,Set,%TmpDirPath%,""

  // Create Ramdrive at startup
  AddAutoRun,PreShell,HideWait,"Initializing Ramdrive...","#$pWinDir#$p\System32\AimRamdrive.exe","%RamDiskSize% %cmb_DriveLetter% %txt_VolLabel% %cmb_DiskFormat%%TmpDirPath%"
End

[#IntegrateDrivers#]
// ===============================================================================================================================
// Name...........: IntegrateDrivers
// Description....: Use Microsoft's Deployment Image Servicing and Management (DISM) tool to integrate drivers into our image.
// Syntax.........: Run,%ScriptFile%,IntegrateDrivers
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: We may be using a modified version of PhDksMnt.ini in order to create the root enumerated device for the SCSI 
//                  adapter (Arsenal Image Mounter storage controller). This breaks the driver signing so make sure to run
//                  DISM with /ForceUnsigned. See https://github.com/ArsenalRecon/Arsenal-Image-Mounter/issues/28 for details.
// Related........:
// ===============================================================================================================================
[IntegrateDrivers]
Echo,"Integrating Drivers...#$x#$xThis can take awhile, please be patient."

ExtractFile,%ScriptFile%,Arsenal,AIM-Driver.7z,%ProjectTemp%
Decompress,"%ProjectTemp%\AIM-Driver.7z","%ProjectTemp%\AIM-Driver"

StrFormat,PATH,%DismLog%,%DismLogPath%
If,Not,ExistDir,%DismLogPath%,DirMake,%DismLogPath%

DISM,"/Image:#$q%TargetDir%#$q /Add-Driver /Driver:#$q%ProjectTemp%\AIM-Driver#$q /Recurse /ForceUnsigned /LogPath:#$q%DismLog%#$q"
If,Not,%^RET%,Equal,0,Halt,"Error: Dism.exe terminated with error code: [%^RET%]. Check the log for details."
// Dism doesn't always unload hives correctly. Force unload just to make sure.
RegUnloadHives,Force,"Target=%TargetSystem32%\config"

[#ViewDismLog#]
// ===============================================================================================================================
// Name...........: ViewDismLog
// Description....: View the log created by the Deployment Image Servicing and Management (DISM) tool. Useful for troubleshooting
//                  failed driver export or integration.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: btn_ViewDismLog
// ===============================================================================================================================
[ViewDismLog]
If,Not,ExistFile,%DismLog%,FileCreateBlank,%DismLog%
ShellExecuteEx,Open,%DismLog%

[#ToggleRamdiskAllocMode#]
// ===============================================================================================================================
// Name...........: ToggleRamdiskAllocMode
// Description....: Hide the fixed disk size options if a Dynamic size is selected.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: 
// Related........: cmb_RamdiskAlloc
// ===============================================================================================================================
[ToggleRamdiskAllocMode]
If,%cmb_RamdiskAlloc%,Equal,"Fixed Size",Begin
  WriteInterface,Visible,%ScriptFile%,Interface,num_RamDiskSize,True
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_RamdiskSizeMode,True
End
Else,Begin
  WriteInterface,Visible,%ScriptFile%,Interface,num_RamDiskSize,False
  WriteInterface,Visible,%ScriptFile%,Interface,cmb_RamdiskSizeMode,False
End

[#ToggleRamdiskFixedMode#]
// ===============================================================================================================================
// Name...........: ToggleRamdiskFixedMode
// Description....: Set the values of the RamDiskSize number box to display RamDrive size in % free memory or MB.
//                  If RamDiskSizeMode is % then set RamDiskSize to display values in the range of 5 to 95 in increments of 5.
//                  If RamDiskSizeMode is MB then set RamDiskSize to display values in the range of 1024 to 9999 in increments of 32.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: Reminder: IniWrite does not update interface variables so don't try referencing %num_RamDiskSize% until a new run.
// Related........: cmb_RamdiskSizeMode, num_RamDiskSize
// ===============================================================================================================================
[ToggleRamdiskFixedMode]
ReadInterface,PosX,%ScriptFile%,Interface,num_RamDiskSize,%X%
ReadInterface,PosY,%ScriptFile%,Interface,num_RamDiskSize,%Y%
If,%cmb_RamdiskSizeMode%,Equal,#$p,IniWrite,%ScriptFile%,Interface,num_RamDiskSize,#$c1#$c2#$c%X%#$c%Y%#$c74#$c22#$c50#$c5#$c95#$c1
Else,IniWrite,%ScriptFile%,Interface,num_RamDiskSize,#$c1#$c2#$c%X%#$c%Y%#$c74#$c22#$c1024#$c32#$c9999#$c8
System,RefreshInterface

[#SetDefaultOptions#]
// ===============================================================================================================================
// Name...........: SetDefaultOptions
// Description....: Sets script options to default values.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........: 
// Related........: btn_SetDefaultOptions
// ===============================================================================================================================
[SetDefaultOptions]
System,Cursor,Wait
WriteInterface,Value,%ScriptFile%,Interface,cb_IncludeAimGUI,False
WriteInterface,Value,%ScriptFile%,Interface,cb_DesktopShc,False
WriteInterface,Value,%ScriptFile%,Interface,cb_StartMenuShc,True
WriteInterface,Value,%ScriptFile%,Interface,cb_PinToTaskbar,False
WriteInterface,Value,%ScriptFile%,Interface,cb_PinToStartMenu,False
WriteInterface,Value,%ScriptFile%,Interface,txt_StartMenuFolder,"System Tools"
WriteInterface,Value,%ScriptFile%,Interface,txt_ShortcutName,"Arsenal Image Mounter"
WriteInterface,Value,%ScriptFile%,Interface,cb_CreateRamdisk,True
WriteInterface,Value,%ScriptFile%,Interface,cb_ChgTemp,True
WriteInterface,Value,%ScriptFile%,Interface,cmb_DriveLetter,"B:"
WriteInterface,Value,%ScriptFile%,Interface,cmb_RamdiskAlloc,"2GB Dynamic"
Run,%ScriptFile%,ToggleRamdiskAllocMode
WriteInterface,Value,%ScriptFile%,Interface,num_RamDiskSize,50
WriteInterface,Value,%ScriptFile%,Interface,cmb_RamdiskSizeMode,"%"
WriteInterface,Value,%ScriptFile%,Interface,cmb_DiskFormat,"NTFS-Compressed"
WriteInterface,Value,%ScriptFile%,Interface,txt_VolLabel,"Ramdisk"
System,Cursor,Normal

[#ToggleAdvancedOptions#]
// ===============================================================================================================================
// Name...........: ToggleAdvancedOptions
// Description....: Show/Hide advanced options.
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: btn_AdvancedOptions
// ===============================================================================================================================
[ToggleAdvancedOptions]
System,SetLocal
ReadInterface,Visible,%ScriptFile%,Interface,lbl_DriveFormat,%state%
If,%state%,Equal,False,Begin
  If,Question,"WARNING!#$x#$xAdvanced options are intended for expert users only!#$x#$xModifying advanced options without knowing what you are doing can cause permanent damage to your project and may result in unexpected behavior and/or build failures.#$x#$xAre you sure you want to continue?",Begin
	Set,%Toggle%,True
    WriteInterface,Resource,%ScriptFile%,Interface,btn_AdvancedOptions,Advanced_Exit_16.png
	WriteInterface,Tooltip,%ScriptFile%,Interface,btn_AdvancedOptions,"Hide Advanced Options"
  End
  Else,Set,%Toggle%,False
End
Else,Begin
  Set,%Toggle%,False
  WriteInterface,Resource,%ScriptFile%,Interface,btn_AdvancedOptions,Advanced_16.png
  WriteInterface,Tooltip,%ScriptFile%,Interface,btn_AdvancedOptions,"Show Advanced Options"
End

WriteInterface,Visible,%ScriptFile%,Interface,lbl_DriveFormat,%Toggle%
WriteInterface,Visible,%ScriptFile%,Interface,cmb_DiskFormat,%Toggle%

[#ShowScriptInfo#]
// ===============================================================================================================================
// Name...........: ShowScriptInfo
// Description....: 
// Syntax.........: 
// Parameters.....: 
// Return values..: 
// Author.........: Homes32
// Remarks........:
// Related........: btn_ScriptInfo
// ===============================================================================================================================
[ShowScriptInfo]
Message,"Arsenal Image Mounter will let you mount image files of hard drive, cd-rom or floppy, and create ramdisks. A Ramdisk (also called a RamDrive) is a block of random-access memory (volatile memory) that a computer is treating as if the memory were a disk drive.#$x#$xRamdisks are particularly useful if your PE is running from read-only media (CD/DVD) and you make use of portable applications or programs that require large %Temp% space.#$x#$xArsenal Image Mounter is developed by Olof Lagerkvist and ArsenalRecon."

